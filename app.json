{
  "expo": {
    "name": "LotusTelco",
    "slug": "lotustelco-dialer",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#040e1a"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lotustelco.dialer",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "LotusTelco needs microphone access to make VoIP calls",
        "NSCameraUsageDescription": "LotusTelco needs camera access for video calls"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#040e1a"
      },
      "package": "com.lotustelco.inc",
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "USE_FULL_SCREEN_INTENT"
      ]
    },
    "scheme": "lotustelco",
    "extra": {
      "eas": {
        "projectId": "9a223211-80ce-49d9-a312-70a816215ec3"
      }
    }
  }
}
